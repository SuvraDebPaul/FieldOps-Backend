NODE_ENV=development
PORT=5000

# Use the POOLED connection string from Neon/Supabase.
# A direct connection exhausts its pool on serverless.
DATABASE_URL="postgresql://user:password@host/fieldops?sslmode=require"

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_32_byte_hex_secret
JWT_REFRESH_SECRET=replace_with_a_different_32_byte_hex_secret
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_EXPIRES=7d

BCRYPT_SALT_ROUNDS=10

# CORS origin for the browser client.
FRONTEND_URL=http://localhost:3000

# Required. Must match the client id that minted the id_token.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Stripe test mode. STRIPE_WEBHOOK_SECRET is printed by `stripe listen`.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=usd

# Required only for avatar upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
