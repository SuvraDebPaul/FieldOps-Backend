NODE_ENV=development
PORT=5000

# Use the POOLED connection string from Neon/Supabase — a serverless deploy
# will exhaust a direct connection.
DATABASE_URL="postgresql://user:password@host/fieldops?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_32_byte_hex_secret_at_least_20_chars
JWT_REFRESH_SECRET=replace_with_a_different_32_byte_hex_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Seeded on first boot — these are the demo credentials in the submission block.
SUPER_ADMIN_NAME=FieldOps Admin
SUPER_ADMIN_EMAIL=admin@fieldops.dev
SUPER_ADMIN_PASSWORD=

# --- Optional until the feature lands ---

# Day 2 — Google sign-in
GOOGLE_CLIENT_ID=

# Day 4 — Upstash Redis (categories + dashboard-stats cache)
REDIS_URL=

# Day 2 — Cloudinary (avatars, request attachments, site reports)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Day 4 — SSLCommerz sandbox
SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
SSLC_IS_LIVE=false
